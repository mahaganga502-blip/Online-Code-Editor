print("\nEnter your Python code.")
print("Type 'RUN' on a new line to finish.\n")
code = []
while True:
    line = input()
    if line.upper() == "RUN":
        break
    code.append(line)
print("\n----------- CODE -----------")
for line in code:
    print(line)
print("----------------------------")
print("\nCode saved successfully!")
print("Total lines:", len(code))


